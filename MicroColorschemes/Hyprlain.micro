color-link default "#e6829e,#000000"
color-link comment "#61333e"

color-link identifier "#965363"
color-link identifier.class "#965363"
color-link identifier.var "#e6829e"

color-link constant "#968C6E"
color-link constant.number "#A05969"
color-link constant.string "#CE7688"

color-link symbol "#804654"
color-link symbol.brackets "#6F3D49"
color-link symbol.tag "#965363"

color-link type "#965363"
color-link type.keyword "#968C6E"

color-link special "#8E4E5D"
color-link statement "#CE7688"
color-link preproc "#804654"

color-link underlined "#968C6E"
color-link error "bold #CE7688"
color-link todo "bold #968C6E"

color-link diff-added "#61333e"
color-link diff-modified "#A05969"
color-link diff-deleted "#CE7688"

color-link gutter-error "#CE7688"
color-link gutter-warning "#968C6E"

color-link statusline "#e6829e,#1A1A1A"
color-link tabbar "#e6829e,#1A1A1A"

color-link indent-char "#2A2A2A"
color-link line-number "#61333e"
color-link current-line-number "#e6829e"

color-link cursor-line "#1A1A1A,#e6829e"
color-link color-column "#1A1A1A"

color-link selection "#e6829e,#804654"

color-link type.extended "default"